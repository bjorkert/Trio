+    /// The pump status at upload time. Omnipod reports delivery as active since `.distantPast`
+    /// while no pod is active, so when the pump manager reports delivery active since before the
+    /// last pump suspend, and no resume, temp basal or pump bolus followed that suspend, the pump
+    /// counts as suspended.
+    private func pumpStatusForUpload() async -> PumpStatus? {
+        let liveStatus = apsManager.pumpManager?.status
+        var status = liveStatus?.pumpStatus
+        if status == nil {
+            status = await storage.retrieveAsync(OpenAPS.Monitor.status, as: PumpStatus.self)
+        }
+        guard let status else {
+            debug(.nightscout, "Pump status for upload: none")
+            return nil
+        }
+
+        var activeSince: Date?
+        if case let .active(date) = liveStatus?.basalDeliveryState {
+            activeSince = date
+        }
+
+        let context = CoreDataStack.shared.newTaskContext()
+        context.name = "pumpStatusForUpload"
+        let eventTypes: [PumpEventStored.EventType] = [.pumpSuspend, .pumpResume, .tempBasal, .bolus]
+        let predicate = NSPredicate(
+            format: "timestamp >= %@ AND type IN %@ AND \(NSPredicate.notScheduledBasal) AND (bolus == nil OR bolus.isExternal == NO)",
+            Date.oneDayAgo as NSDate,
+            eventTypes.map(\.rawValue)
+        )
+        let lastEvent: (type: String, date: Date)? = await context.perform {
+            do {
+                let request = PumpEventStored.fetch(predicate, ascending: false, fetchLimit: 1)
+                guard let event = try context.fetch(request).first, let type = event.type, let date = event.timestamp
+                else { return nil }
+                return (type, date)
+            } catch {
+                warning(.storage, "Pump event fetch for the upload status failed", error: error)
+                return nil
+            }
+        }
+
+        var suspendedInHistory = false
+        if let lastEvent, lastEvent.type == PumpEventStored.EventType.pumpSuspend.rawValue, let activeSince {
+            suspendedInHistory = activeSince < lastEvent.date
+        }
+        let suspended = status.suspended || suspendedInHistory
+
+        let delivery: String
+        switch liveStatus?.basalDeliveryState {
+        case let .active(date): delivery = "active since \(date)"
+        case let .suspended(date): delivery = "suspended since \(date)"
+        case let .tempBasal(dose): delivery = "temp basal \(dose.unitsPerHour) U/h since \(dose.startDate)"
+        case let .some(state): delivery = "\(state)"
+        case .none: delivery = liveStatus == nil ? "no pump manager, stored status" : "unknown"
+        }
+        info(
+            .nightscout,
+            "Pump status for upload: basal delivery \(delivery), pump suspended \(status.suspended), last suspend/resume/delivery event \(lastEvent.map { "\($0.type) at \($0.date)" } ?? "none"), uploading suspended \(suspended)"
+        )
+        return PumpStatus(
+            status: suspended ? .suspended : (status.bolusing ? .bolusing : .normal),
+            bolusing: status.bolusing,
+            suspended: suspended,
+            timestamp: status.timestamp
+        )
+    }
+
