+    @Test("Unchanged mmol/L values keep the stored mg/dL values") func compactKeepsOriginal() throws {
+        let original = TherapyProfileFixtures.profile("W", sens: [(0, 55)], target: [(0, 104, 105)])
+        let compact = CompactTherapyProfile(
+            units: "mmol/L",
