+
+    @Test("Basal rates are kept at three decimal places") func basalRatesRounded() throws {
+        let danaRates = (0 ... 300).map { Double($0) / 100 }.filter { $0 > 0 }.map { Decimal($0) }
+        let noisy = danaRates.filter { $0 != $0.rounded(scale: 3) }
