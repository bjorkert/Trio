+        #expect(mmolL.sensitivity == .init(min: 0.5, max: TherapyProfileFixtures.decimal(29.9), step: 0.1))
+    }
+
+    @Test("A mmol/L profile at the published limits is accepted") func mmolLAtLimits() throws {
